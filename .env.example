PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/trao_ai
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# LLM Providers (Genuine Free Tiers Supported)
# 1. Google Gemini (Recommended Free Tier: 15 RPM / 1M TPM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Free Tier: 14,400 requests/day, Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI / OpenRouter (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
