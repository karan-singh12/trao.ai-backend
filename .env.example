PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/trao_ai
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ====================================================
# LLM Providers Configuration
# ====================================================

# 1. Google Gemini (Free Tier: 15 RPM / 1M TPM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# 2. Groq (Free Tier: 14,400 req/day, ultra-fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com

# 3. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 4. OpenRouter (Access to 200+ models: DeepSeek, Llama, Claude, etc.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ====================================================
# Intelligent Model Routing Configuration
# ====================================================
DEFAULT_LLM_PROVIDER=gemini

# Task-Specific Routing (gemini | groq | openai | openrouter)
ROUTER_EXTRACTION_PROVIDER=gemini
ROUTER_BRIEF_PROVIDER=gemini
ROUTER_QUESTIONS_PROVIDER=openai
ROUTER_FLASHCARDS_PROVIDER=groq
ROUTER_SECONDPASS_PROVIDER=groq
